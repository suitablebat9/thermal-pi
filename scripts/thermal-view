#!/usr/bin/env python3
"""Mac launcher: open the Pi's JPEG feed in an ffplay window through SSH."""
import argparse
import os
import json
import pathlib
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import threading
import queue
from urllib.request import urlopen
from urllib.error import URLError


def feed_demo(player, port, notify=print):
    """Pace requests on the Mac so an emulated Pi never queues a video backlog."""
    url = f'http://127.0.0.1:{port}/api/frame'
    warned = False
    try:
        while player.poll() is None:
            try:
                with urlopen(url, timeout=3) as response:
                    frame = response.read()
                player.stdin.write(frame)
                player.stdin.flush()
                warned = False
            except (URLError, TimeoutError) as exc:
                if not warned:
                    notify(f'Demo frame delayed ({exc}); retrying.')
                    warned = True
            time.sleep(.25)
    except (BrokenPipeError, OSError, ValueError):
        pass
    finally:
        try:
            player.stdin.close()
        except OSError:
            pass


def connection(parser, reset):
    path = pathlib.Path.home() / '.config/thermal-pi/mac-connection.json'
    try:
        if path.exists() and not reset:
            profile = json.loads(path.read_text())
            return profile['host'], profile['port'], profile['demo']
        host = input('Pi SSH address (username@hostname or SSH alias): ').strip()
        if not host or host.startswith('-') or any(c.isspace() for c in host):
            parser.error('Enter the address only, for example pi@localhost.')
        port_text = input('SSH port (Enter for your SSH default): ').strip()
        port = int(port_text) if port_text else None
        if port is not None and not 1 <= port <= 65535:
            parser.error('Port must be between 1 and 65535.')
        mode = input('Camera mode: 1 emulator/demo, 2 real P1 [1]: ').strip()
        if mode not in ('', '1', '2'):
            parser.error('Choose 1 or 2.')
        demo = mode != '2'
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as stream:
            json.dump(dict(host=host, port=port, demo=demo), stream)
        pathlib.Path(stream.name).replace(path)
        return host, port, demo
    except (OSError, ValueError, KeyError, TypeError, EOFError) as exc:
        parser.exit(1, f'Connection setup failed: {exc}. Run thermal-pi --setup.\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--setup', action='store_true', help='change saved Mac connection')
    parser.add_argument('host', nargs='?', help='SSH alias or username@hostname')
    parser.add_argument('-p', '--ssh-port', type=int, help='custom SSH port, including emulator forwarding')
    parser.add_argument('--demo', action='store_true', help='use simulated frames')
    parser.add_argument('--field', action='store_true', help='native-resolution field link')
    parser.add_argument('--fps', type=int, default=8, help='field frame rate cap (1–25)')
    parser.add_argument('--quality', type=int, default=60, help='field JPEG quality (25–90)')
    args = parser.parse_args()
    root = pathlib.Path(__file__).resolve().parents[1]
    if args.field:
        if not 1 <= args.fps <= 25 or not 25 <= args.quality <= 90:
            parser.error('Use --fps 1–25 and --quality 25–90.')
        python = root / '.venv-field/bin/python'
        if not python.exists():
            parser.exit(1, 'From the Mac checkout run: bash scripts/install-mac-field.sh\n')
        if pathlib.Path(sys.prefix) != python.parent.parent:
            os.execv(str(python), [str(python), *sys.argv])
        sys.path.insert(0, str(root))
        from thermal_pi.field import feed
    menu_first = args.host is None or pathlib.Path(sys.argv[0]).name == 'thermal-pi'
    if args.host is None:
        host, port, demo = connection(parser, args.setup)
        args.host = host
        args.ssh_port = args.ssh_port or port
        args.demo = args.demo or demo
    if args.host.startswith('-'):
        parser.error('invalid SSH destination')
    ffplay = shutil.which('ffplay')
    if not ffplay:
        parser.exit(1, 'Install ffplay on the Mac first (brew install ffmpeg).\n')
    with socket.socket() as listener:
        listener.bind(('127.0.0.1', 0))
        local_port = listener.getsockname()[1]
    remote_port = 8082 if args.demo else 8080
    tunnel = f'127.0.0.1:{local_port}:127.0.0.1:{remote_port}'
    destination = args.host + (f' on port {args.ssh_port}' if args.ssh_port else '')
    print(f'Connecting to {destination} and starting the camera service…', flush=True)
    command = ['ssh', '-T', '-o', 'ConnectTimeout=10', '-o', 'ConnectionAttempts=1',
               '-o', 'ExitOnForwardFailure=yes', '-L', tunnel]
    if args.ssh_port:
        command.extend(['-p', str(args.ssh_port)])
    remote = 'cd ~/thermal-pi && exec .venv/bin/python -m thermal_pi.window_session'
    if args.demo:
        remote += ' --demo'
    command.extend([args.host, remote])
    with subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE) as ssh:
        player = None
        menu = None
        try:
            for line in ssh.stdout:
                if line.strip() == b'THERMAL_READY':
                    break
            else:
                parser.exit(1, 'Camera session could not start. Check the SSH message above. Run thermal-pi --setup to change the address or username. If the remote module is missing, run cd ~/thermal-pi && git pull --ff-only on the Pi.\n')
            url = f'http://127.0.0.1:{local_port}/stream.mjpg'
            with tempfile.TemporaryFile() as errors:
                events = queue.SimpleQueue()
                def open_viewer():
                    nonlocal player
                    if player and player.poll() is None:
                        return 'Video window is already open.'
                    options = [ffplay, '-hide_banner', '-loglevel', 'error',
                               '-probesize', '32', '-analyzeduration', '0', '-framedrop', '-autoexit',
                               '-window_title', 'Thermal Pi' + (' - DEMO' if args.demo else '')]
                    if args.field:
                        player = subprocess.Popen(options + ['-f', 'mjpeg', '-framerate', str(args.fps),
                                                  '-i', 'pipe:0'], stdin=subprocess.PIPE, stderr=errors)
                        threading.Thread(target=feed, args=(player, local_port, args.fps, args.quality,
                                         events.put if menu_first else print), daemon=True).start()
                    elif args.demo:
                        player = subprocess.Popen(options + ['-f', 'mjpeg', '-framerate', '4',
                                                  '-i', 'pipe:0'], stdin=subprocess.PIPE, stderr=errors)
                        threading.Thread(target=feed_demo, args=(player, local_port, events.put if menu_first else print), daemon=True).start()
                    else:
                        player = subprocess.Popen(options + ['-f', 'mpjpeg', url],
                                                  stdin=subprocess.DEVNULL, stderr=errors)
                    return 'Opening video window…'
                root = pathlib.Path(__file__).resolve().parents[1]
                if menu_first:
                    sys.path.insert(0, str(root))
                    from thermal_pi.menu import run_menu
                    def pause_viewer():
                        if player and player.poll() is None:
                            player.terminate()
                            player.wait(timeout=3)
                            events.put('Video paused. Press r to reconnect, then v to reopen.')
                    run_menu(local_port, open_viewer, pause_viewer, events)
                    return
                open_viewer()
                menu = subprocess.Popen([sys.executable, '-m', 'thermal_pi.menu', '--port', str(local_port)], cwd=root)
                while ssh.poll() is None and menu.poll() is None and player.poll() is None:
                    time.sleep(.2)
                if player.returncode:
                    errors.seek(0)
                    parser.exit(1, errors.read().decode(errors='replace') or 'Video player exited.\n')
                if ssh.poll() is not None:
                    parser.exit(1, 'SSH disconnected.\n')
        except KeyboardInterrupt:
            pass
        finally:
            for process in (menu, player):
                if process and process.poll() is None:
                    process.terminate()
                    try:
                        process.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
            ssh.stdin.close()
            try:
                ssh.wait(timeout=4)
            except subprocess.TimeoutExpired:
                ssh.kill()
                ssh.wait()


if __name__ == '__main__':
    main()
